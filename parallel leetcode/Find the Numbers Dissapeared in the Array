class Solution:
    def findDisappearedNumbers(self, nums: List[int]) -> List[int]:
        result = []
        Hashmap = {}
        n = len(nums)

        for num in nums:
            Hashmap[num] = True
            

        for i in range(1,n+1):

            if i not in Hashmap:

                result.append(i)

        return result
                

                
        
