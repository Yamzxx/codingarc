# Intuition:
# We use two pointers, one at the beginning and one at the end of the array.
# The area is calculated using:
#     width = distance between pointers
#     height = smaller of the two lines
#
# Since the shorter line limits the amount of water,
# we always move the pointer pointing to the shorter line,
# hoping to find a taller line and increase the area.
#
# We keep updating the maximum area until both pointers meet.
#
# Time Complexity: O(n)
# Space Complexity: O(1)

class Solution:
    def maxArea(self, height):
        left = 0
        right = len(height) - 1
        result = 0

        while left < right:
            width = right - left
            area = min(height[left], height[right]) * width
            result = max(result, area)

            if height[left] < height[right]:
                left += 1
            else:
                right -= 1

        return result
