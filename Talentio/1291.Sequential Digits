#SEQUENTIAL DIGITS
Example 1:

Input: low = 100, high = 300
Output: [123,234]
Example 2:

Input: low = 1000, high = 13000
Output: [1234,2345,3456,4567,5678,6789,12345]
 ###Solution
class Solution:
    def sequentialDigits(self, low: int, high: int) -> List[int]:
        Result = [] #sequentaial list

        for start_digit in range(1,9): #Starting digit can't be 9 since we need at least one more digit after it
            current_number = start_digit 
            #build numbers by appending the consecutive digits
            #next digit must start with +1 or +2
            for next_digit in range(start_digit+1,10):
                # Append the next sequential digit to current number

                current_number = current_number*10+ next_digit
                if low <= current_number <= high: # Check if the formed number is within the given range
                    Result.append(current_number)
        return sorted(Result)

             
        
