class Solution:
    def maxSubArray(self, nums: List[int]) -> int:
        current = nums[0]
        maxi    =nums[0] #startin with the first one

        for i in range(1,len(nums)):#0 index we start ,so 1 we take here
            current = max(nums[i],current+nums[i])

            maxi   = max(current,maxi)

        return maxi

        
