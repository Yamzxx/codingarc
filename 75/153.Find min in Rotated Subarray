class Solution:
    def findMin(self, nums: List[int]) -> int:
        #using binary search

        left = 0 
        right = len(nums) -1

        while left < right:
            m = (left+right) // 2

            if nums[m] < nums[right]:
                right = m
            else:
                left = m + 1
        return nums[left]



    
        
