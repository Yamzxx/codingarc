class Solution:
    def productExceptSelf(self, nums: List[int]) -> List[int]:
        result = [1] * len(nums)

        prefix = 1
        #everything before i
        for i in range(len(nums)):
            result[i] = prefix
            prefix *= nums[i]
        
        postfix = 1
        #everthing after i
        for i in  reversed(range(len(nums))):
            result[i] *= postfix # res = prefix * postfix
            postfix *= nums[i]
        return result

            


        
