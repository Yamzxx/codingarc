from math import gcd

class Solution:
    def subsequencePairCount(self, nums):
        MOD = 10**9 + 7
        MAX = 200

        # dp[g1][g2]
        dp = [[0] * (MAX + 1) for _ in range(MAX + 1)]
        dp[0][0] = 1

        for x in nums:
            new = [row[:] for row in dp]

            for g1 in range(MAX + 1):
                for g2 in range(MAX + 1):
                    if dp[g1][g2] == 0:
                        continue

                    ways = dp[g1][g2]

                    # Put x into seq1
                    ng1 = x if g1 == 0 else gcd(g1, x)
                    new[ng1][g2] = (new[ng1][g2] + ways) % MOD

                    # Put x into seq2
                    ng2 = x if g2 == 0 else gcd(g2, x)
                    new[g1][ng2] = (new[g1][ng2] + ways) % MOD

            dp = new

        ans = 0
        for g in range(1, MAX + 1):
            ans = (ans + dp[g][g]) % MOD

        return ans
