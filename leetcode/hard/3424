class Solution:
    def minDistance(self, n: int, nums: List[int], maxDiff: int, queries: List[List[int]]) -> List[int]:
        arr = sorted((x, i) for i, x in enumerate(nums))

        pos = [0] * n
        vals = [0] * n
        for i, (v, idx) in enumerate(arr):
            pos[idx] = i
            vals[i] = v

        LOG = n.bit_length() + 1
        jump = [[0] * LOG for _ in range(n)]

        r = 0
        for i in range(n):
            while r + 1 < n and vals[r + 1] - vals[i] <= maxDiff:
                r += 1
            jump[i][0] = r

        for k in range(1, LOG):
            for i in range(n):
                jump[i][k] = jump[jump[i][k - 1]][k - 1]

        def solve(l, r):
            if l == r:
                return 0
            if jump[l][LOG - 1] < r:
                return -1

            ans = 0
            cur = l
            for k in range(LOG - 1, -1, -1):
                if jump[cur][k] < r:
                    ans += 1 << k
                    cur = jump[cur][k]
            return ans + 1

        res = []
        for u, v in queries:
            l, r = pos[u], pos[v]
            if l > r:
                l, r = r, l
            res.append(solve(l, r))
        return res
