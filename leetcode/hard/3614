class Solution:
    def processStr(self, s: str, k: int) -> str:
        n = len(s)

        # lengths[i] = length before processing s[i]
        lengths = [0] * (n + 1)

        for i, ch in enumerate(s):
            cur = lengths[i]

            if 'a' <= ch <= 'z':
                lengths[i + 1] = cur + 1

            elif ch == '*':
                lengths[i + 1] = max(cur - 1, 0)

            elif ch == '#':
                lengths[i + 1] = cur * 2

            else:  # '%'
                lengths[i + 1] = cur

        final_len = lengths[n]

        if k < 0 or k >= final_len:
            return '.'

        for i in range(n - 1, -1, -1):
            ch = s[i]

            before = lengths[i]
            after = lengths[i + 1]

            if 'a' <= ch <= 'z':
                # This letter was appended at index = before
                if k == before:
                    return ch

            elif ch == '#':
                # Second half came from first half
                if before > 0 and k >= before:
                    k -= before

            elif ch == '%':
                # Reverse operation
                k = before - 1 - k

            else:  # '*'
                # Deleted the last character.
                # Any remaining index maps to itself.
                pass

        return '.'
