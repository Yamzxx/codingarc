class Solution:
    def maximumElementAfterDecrementingAndRearranging(self, arr: List[int]):

        # Step 1: Sort the array
        arr.sort()

        # Step 2: First element must be 1
        max_val = 1

        # Step 3: Process remaining elements
        for i in range(1, len(arr)):

            # Current element can be at most previous + 1
            max_val = min(arr[i], max_val + 1)

        return max_val
        
