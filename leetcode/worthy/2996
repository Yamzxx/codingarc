class Solution:
    def missingInteger(self, nums: List[int]) -> int:
        consecutive_sum = nums[0]
        #start sum from 0
        for i in range(1,len(nums)):
        #now from 1 we check in a way if the num rn whether is equal to the +1 of the before one 
            if nums[i] == nums[i-1] + 1:

                consecutive_sum += nums[i]
            else:
                break
        
        seen = set(nums)
        #here the answer is consecutive sum
        answer = consecutive_sum

        while answer in seen:
        #if answer in set
        #then we add 1 and fetch
            answer += 1
        #else 
        return answer

        
        
