class Solution:
    def canReach(self, s: str, minJump: int, maxJump: int) -> bool:

        n = len(s)

        # dp[i] = True means index i is reachable
        dp = [False] * n
        dp[0] = True

        reachable_count = 0

        for i in range(1, n):

            # Add new index entering window
            if i - minJump >= 0 and dp[i - minJump]:
                reachable_count += 1

            # Remove old index leaving window
            if i - maxJump - 1 >= 0 and dp[i - maxJump - 1]:
                reachable_count -= 1

            # If current is '0' and some valid previous index exists
            if s[i] == '0' and reachable_count > 0:
                dp[i] = True

        return dp[-1]
