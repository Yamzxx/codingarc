from bisect import bisect_left, bisect_right

class Solution:
    def sumAndMultiply(self, s: str, queries):
        MOD = 10 ** 9 + 7

        pos = []
        digits = []

        for i, ch in enumerate(s):
            if ch != '0':
                pos.append(i)
                digits.append(int(ch))

        k = len(digits)

        prefSum = [0] * (k + 1)
        prefNum = [0] * (k + 1)
        pow10 = [1] * (k + 1)

        for i in range(k):
            prefSum[i + 1] = prefSum[i] + digits[i]
            prefNum[i + 1] = (prefNum[i] * 10 + digits[i]) % MOD
            pow10[i + 1] = (pow10[i] * 10) % MOD

        ans = []

        for l, r in queries:
            L = bisect_left(pos, l)
            R = bisect_right(pos, r) - 1

            if L > R:
                ans.append(0)
                continue

            length = R - L + 1

            x = (
                prefNum[R + 1]
                - prefNum[L] * pow10[length]
            ) % MOD

            digit_sum = prefSum[R + 1] - prefSum[L]

            ans.append((x * digit_sum) % MOD)

        return ans
