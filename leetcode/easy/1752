class Solution:
    def check(self, nums: List[int]) -> bool:
        count = 0
        n = len(nums)

        # Check every element
        for i in range(n):

            # Compare current element with next element
            # % n helps us go back to index 0 after last index
            if nums[i] > nums[(i + 1) % n]:
                count += 1

        # Valid if order breaks at most once
        return count <= 1
