class Solution:
    def arrayRankTransform(self, arr: List[int]):
        # Remove duplicates
        nums = set(arr)

        # Sort the unique numbers
        nums = sorted(nums)

        # Store each number with its rank
        num_to_rank = {}
        for i, num in enumerate(nums):
            num_to_rank[num] = i + 1

        # Replace every element with its rank
        res = []
        for ele in arr:
            res.append(num_to_rank[ele])   # Use ele, not num

        return res
